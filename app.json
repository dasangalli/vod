{
  "expo": {
    "name": "VOD UI",
    "slug": "vodui",
    "owner": "sangaz",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sangaz.vodui"
    },
    "android": {
      "package": "com.sangaz.vodui"
    },
    "extra": {
      "eas": {
        "projectId": "f315fa56-f217-4174-9540-686e75096b81"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
